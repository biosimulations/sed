{
  "tasks": {
    "repeat": {
      "_type": "loop",
      "range": {
        "start": 0,
        "end": 10,
        "interval": 1
      },
      "loopVariables": {
        "looped_model": {
          "initialValue": "#tasks:mod1.model",
          "subsequentValues": "#tasks:repeat:subTasks:sim1.model"
        }
      },
      "subTasks": {
        "sim1": {
          "_type": "oneStepODE",
          "kisaoID": "KISAO:0000694",
          "model": "#tasks:repeat:loopVariables:looped_model",
          "outputModel": true,
          "outputVariables": ["S1", "S2", "S3"],
          "independentVariable": "urn:sedml:symbol:time",
          "independentStep": 1.0
        }
      },
      "outputVariableMap": {
        "sim1_repeat": "#tasks:repeat:subTasks:sim1"
      }
    }
  }
}
