{
  "tasks": {
    "scan_S1_and_k2": {
      "_type": "parameterScan",
      "model": "#tasks:mod1.model",
      "parameterRanges": [
        {
          "modelElement": "S1",
          "start": 0,
          "end": 10,
          "interval": 1
        },
        {
          "modelElement": "k2",
          "start": 0.0001,
          "end": 10,
          "numberOfSteps": 5,
          "scale": "log10"
        }
      ],
      "subTasks": {
        "sim1": {
          "_type": "explicitODESimulation",
          "kisaoID": "KISAO:0000694",
          "model": "#tasks:scan_S1_and_k2:model",
          "outputModel": false,
          "outputVariables": ["S1", "S2", "S3"],
          "independentVariable": "urn:sedml:symbol:time",
          "independentVariableRange": {
              "start": 0,
              "end": 20,
              "interval": 0.5
          }
        }
      },
      "outputVariableMap": {
        "sim1_scan": "#tasks:scan_S1_and_k2:subTasks:sim1"
      },
      "notes": "The simulation data from subTasks:sim1 is exported as 2D data for S1 values by k1 values."
    }
  }
}
