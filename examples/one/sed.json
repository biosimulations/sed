{
    "versionStr": "SED v2.0 alpha",
    "versionNum": 2.0,
    "constants": {
      "compare_labels": [
        "Compare sim1 to sim2",
        "Compare sim1 to data",
        "Compare sim2 to data"
      ]
    },
    "tasks": {
    "model1": {
      "_type": "modelImport",
      "location": "example1.xml",
      "language": "urn:sedml:language:sbml"
    },
    "experiment1": {
      "_type": "dataImport",
      "location": "experimental_data.csv",
      "format": "http://purl.org/NET/mediatypes/text/csv",
      "parameters": {
        "organization": "column-based",
        "ncols": 3,
        "nrows": 52,
        "units": [
          "seconds",
          "mMol",
          "mMol"
        ]
      }
    },
    "sim1": {
      "_type": "explicitODESimulation",
      "kisaoID": "KISAO:0000694",
      "model": "#tasks:model1.model",
      "independentVariable": "urn:sedml:symbol:time",
      "independentVariableInit": 0,
      "independentVariableRange": {
        "start": 0,
        "end": 20,
        "numberOfSteps": 50
      },
      "outputVariables": ["S1", "S2"]
    },
    "sim2": {
      "_type": "explicitODESimulation",
      "kisaoID": "KISAO:0000694",
      "algorithmParameters": {
        "altDefinition": "urn:sedml:algorithms:compareWith",
        "value": "#tasks:sim1"
      },
      "model": "#tasks:model1.model",
      "independentVariable": "urn:sedml:symbol:time",
      "independentVariableInit": 0,
      "independentVariableRange": {
        "start": 0,
        "end": 20,
        "numberOfSteps": 50
      },
      "outputVariables": ["S1", "S2"]
    },
    "sim1_sim2_compare": {
      "_type": "calculation",
      "math": "(#tasks:sim1 - #tasks:sim2)^2"
    },
    "sim1_exp_compare": {
      "_type": "calculation",
      "math": "(#tasks:sim1 - #tasks:experiment1)^2"
    },
    "sim2_exp_compare": {
      "_type": "calculation",
      "math": "(#tasks:sim2 - #tasks:experiment1)^2"
    },
    "compare_summary": {
      "_type": "calculation",
      "math": "[sum(#tasks:sim1_sim2_compare['S1']) + sum(#tasks:sim1_sim2_compare['S2']), sum(#tasks:sim1_exp_compare['S1']) + sum(#tasks:sim1_exp_compare['S2']), sum(#tasks:sim2_exp_compare['S1']) + sum(#tasks:sim2_exp_compare['S2'])]"
    },
    "simcompare_v2": {
      "_type": "sumOfSquares",
      "inputs": [
        "#tasks:sim1",
        "#tasks:sim2",
        "#tasks:experiment1"
      ]
    }
  },
  "outputs": {
    "sim1Report": {
      "_type": "report",
      "dataSets": "#tasks:sim1"
    },
    "sim2Report": {
      "_type": "report",
      "dataSets": "#tasks:sim2"
    },
    "comparisonReport": {
      "_type": "report",
      "dataSets": {
        "time": "#tasks:sim1['time']",
        "S1_ssq_sim1sim2": "#tasks:sim1_sim2_compare['S1']",
        "S1_ssq_sim1exp": "#tasks:sim1_exp_compare['S1']",
        "S1_ssq_sim2exp": "#tasks:sim2_exp_compare['S1']",
        "S2_ssq_sim1sim2": "#tasks:sim1_sim2_compare['S2']",
        "S2_ssq_sim1exp": "#tasks:sim1_exp_compare['S2']",
        "S2_ssq_sim2exp": "#tasks:sim2_exp_compare['S2']"
      }
    },
    "comparisonSummary": {
      "_type": "report",
      "dataSets": {
        "comparison": "#constants:compare_labels",
        "sum of squares": "#tasks:compare_summary"
      }
    },
    "Fig1": {
      "_type": "plot2D",
      "label": "Figure 1",
      "xAxis": {
        "label": "Time"
      },
      "yAxis": {
        "label": "Concentrations"
      },
      "curves": {
        "Sim1_S1": {
          "x": "#tasks:sim1['time']",
          "y": "#tasks:sim1['S1']"
        },
        "Sim1_S2": {
          "x": "#tasks:sim1['time']",
          "y": "#tasks:sim1['S2']"
        },
        "Sim2_S1": {
          "x": "#tasks:sim1['time']",
          "y": "#tasks:sim2['S1']"
        },
        "Sim2_S2": {
          "x": "#tasks:sim1['time']",
          "y": "#tasks:sim2['S2']"
        },
        "S1_data": {
          "x": "#tasks:sim1['time']",
          "y": "#tasks:experiment1['S1']",
          "style": "points_only"
        },
        "S2_data": {
          "x": "#tasks:sim1['time']",
          "y": "#tasks:experiment1['S2']",
          "style": "points_only"
        }
      }
    }
  },
  "styles": {
    "points_only": {
      "line": false,
      "markers": true
    }
  }
}
