{
    "versionStr": "SED v2.0 alpha",
    "versionNum": 2.0,
    "constants": {
      "compare_labels": [
        "Compare sim1 to sim2",
        "Compare sim1 to data",
        "Compare sim2 to data"
      ]
    },
    "tasks": {
    "model1": {
      "_type": "modelImport",
      "location": "example1.xml",
      "language": "urn:sedml:language:sbml"
    },
    "experiment1": {
      "_type": "csvImport",
      "location": "experimental_data.csv",
      "organization": "column-based",
      "separator": "\t",
      "headers": "True",
      "columnNames": ["time", "S1", "S2"],
      "ncols": 3,
      "nrows": 52,
      "units": [
        "seconds",
        "mMol",
        "mMol"
      ]
    },
    "sim1": {
      "_type": "explicitODESimulation",
      "kisaoID": "KISAO:0000694",
      "model": "#tasks:model1.model",
      "independentVariable": "urn:sedml:symbol:time",
      "independentVariableInit": 0,
      "independentVariableRange": {
        "_type": "numericRange",
        "start": 0,
        "end": 20,
        "numberOfSteps": 50
      },
      "outputVariables": ["S1", "S2"]
    },
    "sim2": {
      "_type": "explicitODESimulation",
      "kisaoID": "KISAO:0000694",
      "taskParameters": [
        {
          "altDefinition": "urn:sedml:algorithms:compareWith",
          "value": "#tasks:sim1"
        }
      ],
      "model": "#tasks:model1.model",
      "independentVariable": "urn:sedml:symbol:time",
      "independentVariableInit": 0,
      "independentVariableRange": {
        "_type": "numericRange",
        "start": 0,
        "end": 20,
        "numberOfSteps": 50
      },
      "outputVariables": ["S1", "S2"]
    },
    "sim1_sim2_compare": {
      "_type": "calculation",
      "math": "(#tasks:sim1 - #tasks:sim2)^2"
    },
    "sim1_exp_compare": {
      "_type": "calculation",
      "math": "(#tasks:sim1 - #tasks:experiment1)^2"
    },
    "sim2_exp_compare": {
      "_type": "calculation",
      "math": "(#tasks:sim2 - #tasks:experiment1)^2"
    },
    "compare_summary": {
      "_type": "calculation",
      "math": "[sum(#tasks:sim1_sim2_compare['S1']) + sum(#tasks:sim1_sim2_compare['S2']), sum(#tasks:sim1_exp_compare['S1']) + sum(#tasks:sim1_exp_compare['S2']), sum(#tasks:sim2_exp_compare['S1']) + sum(#tasks:sim2_exp_compare['S2'])]"
    },
    "comparison": {
      "_type": "createDataBlock",
      "data": {
        "time": "#tasks:sim1['time']",
        "S1_ssq_sim1sim2": "#tasks:sim1_sim2_compare['S1']",
        "S1_ssq_sim1exp": "#tasks:sim1_exp_compare['S1']",
        "S1_ssq_sim2exp": "#tasks:sim2_exp_compare['S1']",
        "S2_ssq_sim1sim2": "#tasks:sim1_sim2_compare['S2']",
        "S2_ssq_sim1exp": "#tasks:sim1_exp_compare['S2']",
        "S2_ssq_sim2exp": "#tasks:sim2_exp_compare['S2']"
      }
    },
    "compare_summary_out": {
      "_type": "relabelData",
      "input": "#tasks:compare_summary",
      "labels": "#constants:compare_labels"
    }
  },
  "outputs": {
    "sim1Report": {
      "_type": "report",
      "data": "#tasks:sim1"
    },
    "sim2Report": {
      "_type": "report",
      "data": "#tasks:sim2"
    },
    "comparisonReport": {
      "_type": "report",
      "data": "#tasks:comparison"
    },
    "comparisonSummary": {
      "_type": "report",
      "data": "#tasks:compare_summary_out"
    },
    "Fig1": {
      "_type": "plot2D",
      "name": "Figure 1",
      "xAxis": {
        "name": "Time"
      },
      "yAxis": {
        "name": "Concentrations"
      },
      "curves": {
        "Sim1_S1": {
          "curveType": "points",
          "x": "#tasks:sim1['time']",
          "y": "#tasks:sim1['S1']"
        },
        "Sim1_S2": {
          "curveType": "points",
          "x": "#tasks:sim1['time']",
          "y": "#tasks:sim1['S2']"
        },
        "Sim2_S1": {
          "curveType": "points",
          "x": "#tasks:sim1['time']",
          "y": "#tasks:sim2['S1']"
        },
        "Sim2_S2": {
          "curveType": "points",
          "x": "#tasks:sim1['time']",
          "y": "#tasks:sim2['S2']"
        },
        "S1_data": {
          "curveType": "points",
          "x": "#tasks:sim1['time']",
          "y": "#tasks:experiment1['S1']",
          "style": "#styles:points_only"
        },
        "S2_data": {
          "curveType": "points",
          "x": "#tasks:sim1['time']",
          "y": "#tasks:experiment1['S2']",
          "style": "#styles:points_only"
        }
      }
    }
  },
  "styles": {
    "points_only": {
      "line": false,
      "markers": true
    }
  }
}
